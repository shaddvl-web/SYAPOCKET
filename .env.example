# Pocket Option AI Analyzer Bot - Environment Configuration

# Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bot Operation Mode: 'polling' (local/dev) or 'webhook' (production)
BOT_MODE=polling

# Webhook configuration (only required if BOT_MODE=webhook)
WEBHOOK_URL=https://your-domain.com/telegram-webhook
HOST=0.0.0.0
PORT=8000

# Admin User Telegram IDs (comma-separated integers)
ADMIN_IDS=123456789,987654321

# Database Configuration
DATABASE_PATH=data/bot.db

# Market Data Providers & API Keys
# Default provider options: 'binance' (default for crypto, free/no key required),
# 'twelve_data' (for Forex pairs), 'alpha_vantage', or 'synthetic' (fallback generator)
DEFAULT_MARKET_PROVIDER=binance
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Rate Limiting & Cooldown Protection
RATE_LIMIT_REQUESTS_PER_MIN=20
ANALYSIS_COOLDOWN_SECONDS=5

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional AI / Vision Integration (for future vision chart model)
GEMINI_API_KEY=
